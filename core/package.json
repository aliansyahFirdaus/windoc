{
  "name": "@windoc/core",
  "version": "0.2.11",
  "description": "Canvas-based document editor engine",
  "homepage": "https://aliansyahfirdaus.github.io/windoc/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliansyahFirdaus/windoc.git",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/aliansyahFirdaus/windoc/issues"
  },
  "license": "MIT",
  "keywords": [
    "editor",
    "canvas",
    "document",
    "wysiwyg",
    "windoc"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
