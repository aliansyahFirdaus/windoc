{
  "name": "windoc",
  "version": "0.2.0",
  "private": true,
  "packageManager": "yarn@4.4.1",
  "workspaces": [
    "core",
    "react"
  ],
  "scripts": {
    "build": "yarn workspace @windoc/core build && yarn workspace @windoc/react build",
    "dev": "yarn workspace @windoc/core dev & yarn workspace @windoc/react dev",
    "sync-version": "node scripts/sync-version.js",
    "changelog": "npx git-cliff@latest -o CHANGELOG.md",
    "prepare": "husky",
    "format": "prettier --write \"core/src/**/*.{ts,tsx}\" \"react/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "husky": "^9.1.7",
    "prettier": "^3.5.3"
  }
}
