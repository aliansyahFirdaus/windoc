{
  "name": "@windoc/react",
  "version": "0.3.4",
  "description": "React bindings for windoc editor",
  "homepage": "https://aliansyahfirdaus.github.io/windoc/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliansyahFirdaus/windoc.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/aliansyahFirdaus/windoc/issues"
  },
  "license": "MIT",
  "keywords": [
    "editor",
    "canvas",
    "document",
    "react",
    "windoc",
    "wysiwyg",
    "rich-text-editor",
    "document-editor",
    "react-editor",
    "html5-canvas",
    "pagination"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./src/styles/editor.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@windoc/core": "^0.3.4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
